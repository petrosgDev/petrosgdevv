{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noai, noimageai, noindex, nofollow, noarchive, nosnippet"
        },
        {
          "key": "TDM-Reservation",
          "value": "1"
        }
      ]
    }
  ]
}
