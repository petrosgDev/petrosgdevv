rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Strict single-owner Google account gate (verified email mandatory)
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'petrosgeto7@gmail.com';
    }

    // Lightweight schema & ownership validation (kept well under Firestore's 1000-expression limit)
    function isValidPortfolioDocument(data) {
      return data.keys().hasAll([
          'SITE_PROFILE',
          'NAVIGATION_LINKS',
          'SOCIAL_LINKS',
          'PHILOSOPHY_PILLARS',
          'TECHNICAL_INTERESTS',
          'SKILL_CATEGORIES',
          'EXPERIENCES',
          'PROJECT_CATEGORIES',
          'PROJECTS',
          'BLOG_SETTINGS',
          'updatedByUid',
          'updatedByEmail',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'SITE_PROFILE',
          'NAVIGATION_LINKS',
          'SOCIAL_LINKS',
          'PHILOSOPHY_PILLARS',
          'TECHNICAL_INTERESTS',
          'SKILL_CATEGORIES',
          'EXPERIENCES',
          'PROJECT_CATEGORIES',
          'PROJECTS',
          'BLOG_SETTINGS',
          'THEME_TOKENS',
          'SEO_SETTINGS',
          'updatedByUid',
          'updatedByEmail',
          'createdAt',
          'updatedAt'
        ])
        && data.SITE_PROFILE is map
        && data.NAVIGATION_LINKS is list && data.NAVIGATION_LINKS.size() <= 10
        && data.SOCIAL_LINKS is list && data.SOCIAL_LINKS.size() <= 16
        && data.PHILOSOPHY_PILLARS is list && data.PHILOSOPHY_PILLARS.size() <= 12
        && data.TECHNICAL_INTERESTS is list && data.TECHNICAL_INTERESTS.size() <= 16
        && data.SKILL_CATEGORIES is list && data.SKILL_CATEGORIES.size() <= 20
        && data.EXPERIENCES is list && data.EXPERIENCES.size() <= 25
        && data.PROJECT_CATEGORIES is list && data.PROJECT_CATEGORIES.size() <= 10
        && data.PROJECTS is list && data.PROJECTS.size() <= 40
        && data.BLOG_SETTINGS is map
        && (!('THEME_TOKENS' in data) || data.THEME_TOKENS is map)
        && (!('SEO_SETTINGS' in data) || data.SEO_SETTINGS is map)
        && data.updatedByUid == request.auth.uid
        && data.updatedByEmail == 'petrosgeto7@gmail.com'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /portfolio/{docId} {
      // Public visitors may read ONLY the single published portfolio document; list queries are denied
      allow get: if isValidId(docId) && docId == 'published';
      allow list: if false;

      // Only the verified owner Google account may create, update, or reset/delete /portfolio/published
      allow create: if isAdmin()
        && isValidId(docId)
        && docId == 'published'
        && isValidPortfolioDocument(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(docId)
        && docId == 'published'
        && isValidPortfolioDocument(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin()
        && isValidId(docId)
        && docId == 'published';
    }
  }
}
