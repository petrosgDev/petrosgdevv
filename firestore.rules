rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Strict single-owner Google account gate (verified email mandatory)
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'petrosgeto7@gmail.com';
    }

    function isValidProfileMap(profile) {
      return profile is map
        && profile.keys().hasAll([
          'brand',
          'fullName',
          'role',
          'location',
          'email',
          'phoneDisplay',
          'githubHandle',
          'githubUrl',
          'linkedinHandle',
          'linkedinUrl',
          'telegramHandle',
          'telegramUrl',
          'whatsappUrl',
          'portraitSrc',
          'heroGreeting',
          'heroIntro',
          'shortPhilosophy',
          'copyrightYear',
          'availabilityNote',
          'heroMetrics'
        ])
        && profile.keys().hasOnly([
          'brand',
          'fullName',
          'role',
          'location',
          'email',
          'phoneDisplay',
          'githubHandle',
          'githubUrl',
          'linkedinHandle',
          'linkedinUrl',
          'telegramHandle',
          'telegramUrl',
          'whatsappUrl',
          'portraitSrc',
          'heroGreeting',
          'heroIntro',
          'shortPhilosophy',
          'copyrightYear',
          'availabilityNote',
          'heroMetrics'
        ])
        && profile.brand is string && profile.brand.size() > 0 && profile.brand.size() <= 60
        && profile.fullName is string && profile.fullName.size() > 0 && profile.fullName.size() <= 100
        && profile.role is string && profile.role.size() > 0 && profile.role.size() <= 120
        && profile.location is string && profile.location.size() <= 120
        && profile.email is string && profile.email.size() > 3 && profile.email.size() <= 160
        && profile.phoneDisplay is string && profile.phoneDisplay.size() <= 40
        && profile.githubHandle is string && profile.githubHandle.size() <= 80
        && profile.githubUrl is string && profile.githubUrl.size() <= 1000
        && profile.linkedinHandle is string && profile.linkedinHandle.size() <= 80
        && profile.linkedinUrl is string && profile.linkedinUrl.size() <= 1000
        && profile.telegramHandle is string && profile.telegramHandle.size() <= 80
        && profile.telegramUrl is string && profile.telegramUrl.size() <= 1000
        && profile.whatsappUrl is string && profile.whatsappUrl.size() <= 1000
        && profile.portraitSrc is string && profile.portraitSrc.size() <= 1000
        && profile.heroGreeting is string && profile.heroGreeting.size() <= 80
        && profile.heroIntro is string && profile.heroIntro.size() <= 800
        && profile.shortPhilosophy is string && profile.shortPhilosophy.size() <= 400
        && profile.copyrightYear is int && profile.copyrightYear >= 2020 && profile.copyrightYear <= 2100
        && profile.availabilityNote is string && profile.availabilityNote.size() <= 300
        && profile.heroMetrics is list && profile.heroMetrics.size() > 0 && profile.heroMetrics.size() <= 8
        && profile.heroMetrics[0] is map;
    }

    function isValidBlogSettingsMap(blog) {
      return blog is map
        && blog.keys().hasAll(['telegramChannel', 'subtitle'])
        && blog.keys().hasOnly(['telegramChannel', 'subtitle'])
        && blog.telegramChannel is string
        && blog.telegramChannel.size() >= 5
        && blog.telegramChannel.size() <= 32
        && blog.telegramChannel.matches('^[a-zA-Z0-9_]{5,32}$')
        && blog.subtitle is string
        && blog.subtitle.size() <= 300;
    }

    function isValidMapList(items, maxSize, allowEmpty) {
      return items is list
        && items.size() <= maxSize
        && ((allowEmpty && items.size() == 0) || (items.size() > 0 && items[0] is map));
    }

    function isValidStringList(items, maxSize) {
      return items is list
        && items.size() > 0
        && items.size() <= maxSize
        && items[0] is string;
    }

    // Pillar 2: Standalone validation blueprint used on both create and update
    function isValidPortfolioDocument(data) {
      return data.keys().hasAll([
          'SITE_PROFILE',
          'NAVIGATION_LINKS',
          'SOCIAL_LINKS',
          'PHILOSOPHY_PILLARS',
          'TECHNICAL_INTERESTS',
          'SKILL_CATEGORIES',
          'EXPERIENCES',
          'PROJECT_CATEGORIES',
          'PROJECTS',
          'BLOG_SETTINGS',
          'updatedByUid',
          'updatedByEmail',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'SITE_PROFILE',
          'NAVIGATION_LINKS',
          'SOCIAL_LINKS',
          'PHILOSOPHY_PILLARS',
          'TECHNICAL_INTERESTS',
          'SKILL_CATEGORIES',
          'EXPERIENCES',
          'PROJECT_CATEGORIES',
          'PROJECTS',
          'BLOG_SETTINGS',
          'updatedByUid',
          'updatedByEmail',
          'createdAt',
          'updatedAt'
        ])
        && isValidProfileMap(data.SITE_PROFILE)
        && isValidMapList(data.NAVIGATION_LINKS, 10, false)
        && isValidMapList(data.SOCIAL_LINKS, 16, false)
        && isValidMapList(data.PHILOSOPHY_PILLARS, 12, true)
        && isValidMapList(data.TECHNICAL_INTERESTS, 16, true)
        && isValidMapList(data.SKILL_CATEGORIES, 20, true)
        && isValidMapList(data.EXPERIENCES, 25, true)
        && isValidStringList(data.PROJECT_CATEGORIES, 10)
        && isValidMapList(data.PROJECTS, 40, false)
        && isValidBlogSettingsMap(data.BLOG_SETTINGS)
        && data.updatedByUid is string
        && data.updatedByUid.size() > 0
        && data.updatedByUid.size() <= 128
        && data.updatedByUid == request.auth.uid
        && data.updatedByEmail is string
        && data.updatedByEmail.size() > 0
        && data.updatedByEmail.size() <= 160
        && data.updatedByEmail == 'petrosgeto7@gmail.com'
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /portfolio/{docId} {
      // Public visitors may read ONLY the single published portfolio document; list queries are denied
      allow get: if isValidId(docId) && docId == 'published';
      allow list: if false;

      // Only the verified owner Google account may create, update, or reset/delete /portfolio/published
      allow create: if isAdmin()
        && isValidId(docId)
        && docId == 'published'
        && isValidPortfolioDocument(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(docId)
        && docId == 'published'
        && isValidPortfolioDocument(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'SITE_PROFILE',
          'NAVIGATION_LINKS',
          'SOCIAL_LINKS',
          'PHILOSOPHY_PILLARS',
          'TECHNICAL_INTERESTS',
          'SKILL_CATEGORIES',
          'EXPERIENCES',
          'PROJECT_CATEGORIES',
          'PROJECTS',
          'BLOG_SETTINGS',
          'updatedByUid',
          'updatedByEmail',
          'updatedAt'
        ]);

      allow delete: if isAdmin()
        && isValidId(docId)
        && docId == 'published';
    }
  }
}
